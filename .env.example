# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/tender
REDIS_URL=redis://localhost:6379/0

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ALERT_CHAT_ID=YOUR_CHAT_ID

# Telegram API for Channel Monitoring
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_MONITOR_ENABLED=false

# Google Sheets Configuration
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_NAME=Tender Parser
GOOGLE_SHEETS_SHARE_EMAIL=
GOOGLE_SHEETS_AUTO_EXPORT=false

# Scraper Configuration
SOURCE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Scraping Schedule
SCRAPE_EVERY_MINUTES=15
SCRAPE_HOUR=9
SCRAPE_MINUTE=0

# Winner checker (daily, Asia/Tashkent)
WINNER_CHECK_HOUR=9
WINNER_CHECK_MINUTE=0
WINNER_DAYS_BACK=365
WINNER_BATCH_LIMIT=0
WINNER_API_DELAY_SECONDS=0.15

# Production Settings (for Docker)
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
